    "encoder": {
        "rotary": [
            {
                "pin_a": "GP27",
                "pin_b": "GP26",
                "resolution": 4
            }
        ]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"label": "1", "matrix": [0, 0], "x": 0, "y": 0},
                {"label": "2", "matrix": [0, 1], "x": 1, "y": 0},
                {"label": "3", "matrix": [0, 2], "x": 2, "y": 0},
                {"label": "4", "matrix": [1, 0], "x": 0, "y": 1},
                {"label": "5", "matrix": [1, 1], "x": 1, "y": 1},
                {"label": "6", "matrix": [1, 2], "x": 2, "y": 1}
            ]
        }
    }
}